# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Environments
.venv/
env/
venv/
ENV/

# Build and packaging
build/
dist/
*.egg-info/
.eggs/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Temporary outputs / caches
*.log
uv.lock

# Heavy data, models, and experiment results
*.npy
*.npz
*.pkl
*.pt
*.pth
*.h5
*.parquet
results_no_explore/
weeks/*/results_no_explore/
weeks/*/results/*/

# Explicitly keep necessary deliverables
!weeks/**/results/sweep.csv
